# Server
SERVER_PORT=8080
SERVER_MODE=release

# PostgreSQL database used by WeAuth
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=weauth
DB_PASSWORD=change-me
DB_NAME=weauth

# JWT
JWT_SECRET=replace-with-a-random-32-byte-secret
JWT_EXPIRE_HOURS=24

# OIDC provider
OIDC_CLIENT_ID=your-oidc-client-id
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_DISCOVERY_URL=https://your-issuer.example.com/.well-known/openid-configuration
OIDC_REDIRECT_URL=http://localhost:8080/api/auth/oidc/callback
FRONTEND_URL=http://localhost:5173

# Comma-separated frontend origins
CORS_ORIGINS=http://localhost:5173
